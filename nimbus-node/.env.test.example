# ==============================================================================
# Environment Configuration Template for Nimbus Relayer Node
# ==============================================================================
# Copy this file to .env.test or your shell profile, configure values, and source it.
# e.g., cp .env.test.example .env.test && source .env.test
# ==============================================================================

# 1. General Node & Network Configurations
export NIMBUS_ENV="test"                            # Modes: development, test, hard-test, production, mainnet
export PORT="8080"                                  # Bind port for the HTTP/REST API server
export NIMBUS_BIND_ADDR="127.0.0.1"                 # Bind interface (e.g., 127.0.0.1, or Tailscale IP like 100.64.0.1)
export NIMBUS_REQUIRE_TAILSCALE="false"             # Enforces binding to Tailscale IP if set to true

# 2. Database Configurations
export NIMBUS_DB_PATH="./test-relayer.db"           # Path to SQLite/SQLCipher persistent database
export NIMBUS_DB_KEY="default-change-in-production" # SQLCipher encryption key (change to a secure key in prod/mainnet)

# 3. Cryptographic Key Sharing (Ceremony Settings)
export NIMBUS_SHARE_INDEX="1"                       # Node index (e.g. 1 for Leader, 2-5 for Guardians)
export NIMBUS_SHARE_KEY="0x_YOUR_MPC_SHARE_KEY_HEX" # BLS12-381 secret key share for this node index (modulus-compliant)
export NIMBUS_THRESHOLD="3"                         # Threshold number of signatures required (t)
export NIMBUS_ISSUER_PUBLIC_KEY="0x_ISSUER_PK_HEX"  # BLS12-381 Issuer ceremony public key

# 4. Guardian Public Keys Registry (Excluding this node's index)
# JSON string mapping index -> compressed G2 public key share hex
export NIMBUS_GUARDIAN_PUBLIC_KEYS='{
  "2": "0x_GUARDIAN_2_PUBLIC_KEY_HEX",
  "3": "0x_GUARDIAN_3_PUBLIC_KEY_HEX",
  "4": "0x_GUARDIAN_4_PUBLIC_KEY_HEX",
  "5": "0x_GUARDIAN_5_PUBLIC_KEY_HEX"
}'

# 5. Trusted Leaders (For Guardians to verify Leader's EIP-712 messages)
# Comma-separated list of trusted Leader Ethereum wallet addresses
export NIMBUS_TRUSTED_LEADERS="0x_LEADER_ETH_SIGNER_ADDRESS"

# 6. EVM & Blockchain Configurations (Required for hard-test / production)
export NIMBUS_RPC_URL="https://arbitrum-sepolia.core.chainstack.com/YOUR_API_KEY"
export NIMBUS_RPC_FALLBACK_URL="https://arbitrum-sepolia.infura.io/v3/YOUR_PROJECT_ID"
export NIMBUS_RELAYER_PRIVATE_KEY="0x_YOUR_RELAYER_PRIVATE_KEY_HEX"
export NIMBUS_CONTRACT_ADDRESS="0x_YOUR_DEPLOYED_CONTRACT_ADDRESS_HEX"
export NIMBUS_BATCH_ENABLED="false"                  # Set to true to enable same-chain micro-batching using batchSpend()


# 7. Vault/OpenBao KMS Integration (Required in strict modes like hard-test/production)
# If NIMBUS_VAULT_TOKEN is set, key loading switches exclusively to Vault (NIMBUS_SHARE_KEY is ignored)
# export NIMBUS_VAULT_TOKEN="hvs.your-vault-token"
# export NIMBUS_VAULT_ADDR="http://127.0.0.1:8200"
# export NIMBUS_VAULT_PATH="v1/secret/data/nimbus"
