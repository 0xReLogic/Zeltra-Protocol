# ==============================================================================
# Environment Configuration Template for Zeltra Relayer Sequencer Node (DEC-038A/C)
# ==============================================================================
# Copy this file to .env.test or your shell profile, configure values, and source it.
# e.g., cp .env.test.example .env.test && source .env.test
# ==============================================================================

# 1. General Node & Network Configurations
export NIMBUS_ENV="test"                            # Modes: development, test, hard-test, production, mainnet
export PORT="8080"                                  # Bind port for the HTTP/REST API server
export NIMBUS_BIND_ADDR="127.0.0.1"                 # Bind interface (e.g., 127.0.0.1, or Tailscale IP)
export NIMBUS_REQUIRE_TAILSCALE="false"             # Enforces binding to Tailscale IP if set to true

# 2. Database Configurations
export NIMBUS_DB_PATH="./test-relayer.db"           # Path to SQLite/SQLCipher persistent database
export NIMBUS_DB_KEY="default-change-in-production" # SQLCipher encryption key (change to a secure key in prod/mainnet)

# 3. EVM & Blockchain Configurations (Required for hard-test / production)
export NIMBUS_RPC_URL="https://arbitrum-sepolia.core.chainstack.com/YOUR_API_KEY"
export NIMBUS_RPC_FALLBACK_URL="https://arbitrum-sepolia.infura.io/v3/YOUR_PROJECT_ID"
export NIMBUS_CHAIN_ID="421614"                      # Arbitrum Sepolia: 421614, Arbitrum One: 42161
export NIMBUS_RELAYER_PRIVATE_KEY="0x_YOUR_RELAYER_PRIVATE_KEY_HEX"
export NIMBUS_RELAYER_ADDRESS="0x_YOUR_RELAYER_ETH_ADDRESS"
export NIMBUS_CONTRACT_ADDRESS="0x_YOUR_DEPLOYED_CONTRACT_ADDRESS_HEX"
export NIMBUS_STABLECOIN_ADDRESS="0x75faf114eafb1bdbe2f0316df893fd58ce46aa4d" # Sepolia native USDC
export NIMBUS_CURRENT_EPOCH="0"                      # Contract settlement epoch override (optional)

# 4. Settlement, Direct Spend & Fee Economics (DEC-028, DEC-029)
export NIMBUS_RELAYER_MARKUP_BPS="1500"              # Relayer execution fee markup in bps (1500 = 15.00%)
export NIMBUS_ESTIMATED_GAS_COST_USDC_BASE_UNITS="150000" # Static estimated gas cost in USDC base units (0.15 USDC, 6 decimals)
export NIMBUS_ETH_PRICE_USDC="3500.0"                # Fallback static ETH price in USDC for margin accounting
export NIMBUS_CHAINLINK_ETH_FEED="0xd30e2101a97dcbAeBCBC04F14C3f624E67A35165" # Chainlink ETH/USD feed
export NIMBUS_ETH_PRICE_CACHE_TTL_SECS="300"        # Price cache TTL in seconds (default: 5 min)
export NIMBUS_ETH_PRICE_STALENESS_SECS="3600"       # Max age of oracle round before declaring stale (default: 1 hour)

# 5. Receipt Finality, Nonce Lock & Mempool Watchdog (DEC-017 & DEC-027)
export NIMBUS_CONFIRMATION_THRESHOLD="1"             # Block confirmations before marking confirmed (default: 1 for Arbitrum)
export NIMBUS_TX_TIMEOUT_SECS="30"                   # Timeout before replacing stuck mempool tx (default: 30s)
export NIMBUS_GAS_BUMP_PERCENT="15"                  # Gas price replacement bump percentage (default: 15%)
export NIMBUS_MAX_GAS_BUMPS="3"                      # Maximum replacement attempts before failure (default: 3)
export NIMBUS_MEMPOOL_LEASE_SECS="900"               # Worker lease duration for spend queue items (default: 900s = 15m)
export NIMBUS_WATCHDOG_INTERVAL_SECS="30"            # Loop interval for mempool lease expiration watchdog (default: 30s)

# 6. Safety Limits & Spend Filtering (DEC-026 Compliance & Policy)
export NIMBUS_MIN_SPEND_USDC="5000000"               # Minimum single spend amount in base units (5.00 USDC)
export NIMBUS_MAX_SPEND_USDC="50000000000"           # Maximum single spend amount in base units (50,000.00 USDC)
export NIMBUS_ALLOWED_CHAIN_SELECTORS="16015286601757825753,10344971235874465080" # Comma-separated allowlisted CCIP chain selectors

# 7. CCIP Cross-Chain Destination Tracking & Routers (Phase 4 / DEC-016)
export NIMBUS_CCIP_ROUTER="0x2a9C5afB0d0e4BAb2BCdaE109EC4b0c4Be15a165" # CCIP Router on Arbitrum Sepolia
export NIMBUS_CCIP_NETWORK_FEE_USDC="800000"         # Estimated cross-chain network fee (0.80 USDC = 800,000 base units)
export NIMBUS_DESTINATION_RPC_URL="https://sepolia.infura.io/v3/YOUR_PROJECT_ID" # Destination chain RPC for OffRamp tracking
export NIMBUS_CCIP_OFFRAMP="0x_DESTINATION_CHAIN_CCIP_OFFRAMP_ADDRESS" # CCIP OffRamp contract on destination chain
export NIMBUS_CCIP_REFUND_TIMEOUT_SECS="86400"       # Timelock before freeing failed cross-chain nullifier (default: 24h)

# 8. X402 Payment Facilitator Gateway (Optional HTTP 402 Extension)
# export NIMBUS_X402_RECIPIENT="0x_MERCHANT_OR_FACILITATOR_USDC_PAYOUT_ADDRESS"
